PORT=5000
JWT_SECRET=your_jwt_secret_here

# Firestore (production). Omit these and set FIRESTORE_IN_MEMORY=1 for local tests.
# FIREBASE_PROJECT_ID=your-project-id
# Named Firestore database (omit to use (default))
# FIRESTORE_DATABASE_ID=your-database-id
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# or GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json
FIRESTORE_IN_MEMORY=1

# Public site origin (Firebase Hosting). Used for CORS, email links, and PayPal return URLs.
FRONTEND_URL=https://YOUR_PROJECT.web.app
PUBLIC_API_URL=https://YOUR_PROJECT.web.app

# Resend (https://resend.com)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@reset.sporff.ca

# Admin login
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-8-chars

# Cloudflare R2 (video + playbook media — keep this instead of Firebase Storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=chme-videos
# Optional override:
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com

# PayPal Subscriptions (developer.paypal.com → Apps & Credentials)
# Webhook URL after Firebase Hosting is live:
#    https://YOUR_PROJECT.web.app/api/billing/paypal-webhook
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD
# Required to accept billing webhooks. Unsigned requests are rejected without this.
PAYPAL_WEBHOOK_ID=
